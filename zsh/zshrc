# pm-terminal-config — zsh
# Dependencies (provisioned by install.sh):
#   - oh-my-zsh, znap, oh-my-posh, nvm, fzf

# znap (cloned by install.sh to ~/Repos/znap)
[ -s "$HOME/Repos/znap/znap.zsh" ] && source "$HOME/Repos/znap/znap.zsh"

# oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="half-life"
plugins=(git)
[ -s "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# oh-my-posh prompt
command -v oh-my-posh >/dev/null 2>&1 && \
  eval "$(oh-my-posh init zsh --config "$HOME/poshconfig/pm2.json")"

# Secrets (API keys, tokens) live in ~/.zshrc.secrets.
# That file is NEVER committed — create it locally with chmod 600 and export
# your keys from there, e.g.:
#   export OPENAI_API_KEY='...'
#   export DD_API_KEY='...'
[ -f "$HOME/.zshrc.secrets" ] && source "$HOME/.zshrc.secrets"

# ---- Convenience ----
alias ssaver="/usr/local/bin/pipes.sh -t 0"
alias weather="curl wttr.in/New+York+City"
alias senv="source venv/bin/activate"
alias bk="cd .. && clear"
alias zsrc="source ~/.zshrc"

# ---- Kubernetes ----
alias k="kubectl"
alias kns="kubens"
alias kx="kubectl exec -it"

# ---- Docker ----
alias d="docker"
alias dps="docker ps"
alias dx="docker exec -it"

# ---- Git ----
alias ghc="git add . && git commit -a -S -m"
alias gpo="git push origin"
alias gpom="git pull -S origin master"
alias gpol="git pull -S origin"
alias gcb="git checkout -b"
alias gc="git checkout"
alias gcl="git clone"
alias gst="git status"
alias gback="git checkout origin/master -- "

parse_git_branch() {
  git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ (\1)/'
}

parse_git_branch_gpush() {
  git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/\1/'
}

# gpush: stage, signed-commit, push — auto-prefixes commit with the Jira ticket
# (DP-NNNN) extracted from the branch name. Adjust the regex if your team uses
# a different ticket prefix.
gpush() {
  git add . \
    && git commit -a -S -m "[$(parse_git_branch_gpush | grep -oE 'DP-[0-9]+')] $1" \
    && git push origin "$(parse_git_branch_gpush)"
}

# ---- Hash / encoding helpers ----
alias sha256b64='function _emailsha256() { echo -n "$1" | openssl dgst -sha256 -binary | openssl base64; }; _emailsha256'
alias sha256b64url='function _emailsha256() { echo -n "$1" | openssl dgst -sha256 -binary | openssl base64 | sed -E "s/\+/%2B/g; s/\//%2F/g; s/=/%3D/g"; }; _emailsha256'
alias sha256='function _emailsha256() { echo -n "$1" | openssl dgst -sha256 | sed "s/^.*= //" }; _emailsha256'
alias md5='function _md5() { echo -n "$1" | md5; }; _md5'
alias md5b64='function _md5b64() { echo -n "$1" | md5 | xxd -r -p | base64; }; _md5b64'
alias b64er='function _b64er() {echo -n "$1" | xxd -r -p | openssl base64; }; _b64er'

# ---- Terraform ----
alias tfmt="terraform fmt -recursive ."

# ---- Prompt + autocomplete plugin ----
export PS1=' %F{white}$(pwd)%f 💎%F{cyan}$(parse_git_branch)%f <?> '
command -v znap >/dev/null 2>&1 && znap source marlonrichert/zsh-autocomplete
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=5'

# ---- Toolchains ----
# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Go
export GO111MODULE="on"
export GOPATH="$HOME/go"
command -v go >/dev/null 2>&1 && export PATH="$PATH:$(go env GOPATH)/bin"

# Homebrew (Apple Silicon default)
[ -x /opt/homebrew/bin/brew ] && export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

# .NET tools
export PATH="$HOME/.dotnet/tools:$PATH"

# Local bin
export PATH="$HOME/.local/bin:$PATH"

# fzf
[ -f "$HOME/.fzf.zsh" ] && source "$HOME/.fzf.zsh"
